{
  "mcpServers": {
    "aris-mcp": {
      "command": "uv",
      "args": [
        "run",
        "aris-mcp"
      ],
      "env": {
        "MCP_TOOL_MODE": "intent",
        "ARISTOOL": "True",
        "ARIS_API_BASE": "http://localhost/abs/api",
        "ARIS_ENABLE_WRITE": "False",
        "ARIS_SSL_VERIFY": "True"
      }
    }
  }
}
