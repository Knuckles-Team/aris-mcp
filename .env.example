# --- ARIS connection ---
# ARIS REST base URL (tenant API root). Default follows the ARIS Connect ABS layout.
ARIS_API_BASE=http://localhost/abs/api

# Verify TLS (set False for self-signed / homelab tenants)
ARIS_SSL_VERIFY=True

# --- ARIS authentication (first match wins) ---
# 1. OAuth2 client-credentials (preferred for ARIS Cloud / Connect)
ARIS_OAUTH_URL=
ARIS_CLIENT_ID=
ARIS_CLIENT_SECRET=
ARIS_TENANT=

# 2. Static bearer token (alternative to OAuth)
ARIS_TOKEN=

# 3. HTTP basic auth (alternative)
ARIS_USERNAME=
ARIS_PASSWORD=

# Optional JSON overriding the default ARIS REST path templates per tenant
# e.g. {"models":"v2/repository/models","model_objects":"v2/models/{model_id}/objects"}
ARIS_PATHS_JSON=

# Allow (gated) attribute writes back onto ARIS models (KG writeback)
ARIS_ENABLE_WRITE=False

# --- MCP server / transport ---
# stdio, streamable-http, or sse
TRANSPORT=stdio
HOST=0.0.0.0
PORT=8000

# Tool surface: condensed, verbose, or both
MCP_TOOL_MODE=condensed
# Comma-separated tool / tag allow/deny lists
MCP_ENABLED_TOOLS=
MCP_DISABLED_TOOLS=
MCP_ENABLED_TAGS=
MCP_DISABLED_TAGS=

DEBUG=False
PYTHONUNBUFFERED=1

# --- Tool toggle switches (per-domain <DOMAIN>TOOL; set False to disable) ---
# The action-routed ARIS tools (aris_model, aris_object) share this toggle.
ARISTOOL=True

# --- Telemetry (OpenTelemetry) ---
ENABLE_OTEL=True
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=

# --- Governance (Eunomia authorization) ---
EUNOMIA_TYPE=none
EUNOMIA_POLICY_FILE=mcp_policies.json
EUNOMIA_REMOTE_URL=
